# Copy this file to .env and fill in real values for your environment.
# Never commit the real .env file.

# PostgreSQL connection string used by the app directly (local dev, or any
# deployment where you provide DATABASE_URL yourself).
DATABASE_URL="postgresql://erm_app:changeme@127.0.0.1:5432/erm_db?schema=public"

# Only read by docker-compose.yml, to configure the bundled postgres
# container and build the same DATABASE_URL for the app/migrate services.
# Keep these in sync with DATABASE_URL above if you change them.
POSTGRES_USER="erm_app"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="erm_db"

# Session signing secret. Generate a new one for every environment:
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-value"

# Public base URL of the app, used to build absolute links in emails.
APP_URL="http://localhost:3000"

# Email (SMTP). Leave all three blank to have the mailer log emails to the
# server console instead of sending them (useful for local development).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ERM Platform <no-reply@erm.local>"

# Local file storage directory for uploaded attachments/documents.
UPLOADS_DIR="./uploads"

# Optional shared secret for headless cron calls to
# /api/notifications/check-due (Authorization: Bearer <value>). Leave blank
# to require an authenticated System Administrator/CRO session instead.
CRON_SECRET=""
